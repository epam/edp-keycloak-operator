{
  "permissions": {
    "allow": [
      "Skill(run-tests)",
      "Skill(run-tests:*)",
      "Skill(run-golangci-lint)",
      "Skill(run-golangci-lint:*)",
      "Skill(generate-mocks)",
      "Skill(generate-mocks:*)",
      "Skill(cr-field)",
      "Skill(cr-field:*)",
      "Bash(make mocks)",
      "Bash(TEST_KEYCLOAK_URL=http://localhost:8086 make test)",
      "Bash(docker ps --filter name=keycloak-test --format '{{.Names}}')",
      "Bash(make lint-fix 2>&1)",
      "Bash(make generate:*)",
      "Bash(make manifests:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(make start-keycloak:*)",
      "Bash(make test:*)",
      "Bash(kubectl --context kind-krci *)",
      "Bash(helm list*)",
      "Bash(helm get *)",
      "Bash(helm template *)",
      "Bash(curl -s -o /dev/null -w * http://localhost:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lane-allow.py"
          }
        ]
      }
    ]
  }
}
